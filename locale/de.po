# Settings, AI: where a key is kept, and where it may go from a web page (keysafe)
msgid "Remember on this device"
msgstr "Auf diesem Gerät merken"

msgid "Kept in this computer's keyring (the Secret Service, as GNOME Keyring or KWallet keeps it), locked with your login"
msgstr "Im Schlüsselbund dieses Computers gespeichert (dem Secret Service, wie GNOME Keyring oder KWallet ihn führt), geschützt durch deine Anmeldung"

msgid "Kept in your login Keychain on this Mac, locked with your login"
msgstr "In deinem Schlüsselbund „Anmeldung“ auf diesem Mac gespeichert, geschützt durch deine Anmeldung"

