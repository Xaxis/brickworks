msgstr "La sélectionner avec tout ce qui y est relié"

msgid "Lock"
msgstr "Verrouiller"

msgid "Keep it from being picked out, moved, painted or taken off"
msgstr "L'empêcher d'être choisie, déplacée, peinte ou enlevée"

msgid "Hide it, to reach what is behind it"
msgstr "La masquer, pour atteindre ce qui est derrière"

