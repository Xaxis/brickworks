				},
				{
					"name": "render", "caption": "render", "still": "render.png", "seconds": 3.6, "push": 1.07, "fade": 18,
					"setup": [{"picture": "render", "size": [1920, 1200], "quality": "best", "look": "product", "stage": "wood", "view": "hero"}]
