# Vendored upstream data — re-fetch with tools/fetch_data.sh, never commit
vendor/
build/
dist/
.vercel/
.env
.env.local

# Generated assets. Both are derived from vendor/ and reproducible:
# tools/build_meshes.py writes generated/, tools/web_pack.py selects web/.
assets/generated/
assets/web/
godot/assets/parts/
*.pck
*.wasm

# Godot
.godot/
.import/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Node
node_modules/

# Editors / OS
.idea/
.DS_Store
*.swp
shots/
models/design.ldr
.vercel
tools/web/node_modules/
tools/web/package-lock.json

# Web assets are served, not imported. web/.gdignore keeps the engine out.
*.import

# Scratch probes. A review agent that tests its own hypothesis by
# writing a probe and running it is doing the right thing — this
# project's rule is to measure rather than reason — but those files are
# working notes, not the suite. Twenty-six of them reached main because
# the commits that followed used "git add -A".
src/dev/_*
