; Engine configuration file.
; Hand-edited on purpose: kept small and readable.

config_version=5

[application]

config/name="Brickworks"
config/description="A dimensionally exact brick construction system."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

; Untyped declarations are an error here. The hot paths move hundreds of
; thousands of vertices and GDScript only generates fast typed opcodes when
; it can see the type.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[filesystem]

; .lbm part geometry is read with FileAccess, not the resource loader, so
; the editor must not try to import it.
import/blender/enabled=false

[rendering]

; A universal macOS binary has to be able to run on Apple silicon, and
; Godot refuses to build one unless the mobile texture format is enabled
; — even for a project with no imported textures, as this one currently
; is. Cheap to leave on, and it fails the export loudly if left off.
textures/vram_compression/import_etc2_astc=true

; A brick is 24 units tall (1 unit = 1 LDU = 0.4 mm), and a big model runs
; to a few thousand units. The near plane has to be tight enough to let the
; camera sit on a single stud without clipping it.
camera/depth_of_field/depth_of_field_bokeh_shape=0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
