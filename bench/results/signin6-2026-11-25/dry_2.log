public.oauth_codes:
  hash text not null
  client_id text not null
  owner uuid not null
  redirect_uri text not null
  code_challenge text not null
  resource text not null
  scope text
  expires_at timestamp with time zone not null
  created_at timestamp with time zone not null default now()
  oc_did text
  oc_rh text
  oc_aud text
  oc_iat bigint
  way text
  session_id uuid
  constraint oauth_codes_client_id_fkey: FOREIGN KEY (client_id) REFERENCES oauth_clients(client_id) ON DELETE CASCADE
  constraint oauth_codes_code_challenge_check: CHECK ((code_challenge ~ '^[A-Za-z0-9_-]{43}$'::text))
  constraint oauth_codes_hash_check: CHECK ((hash ~ '^[0-9a-f]{64}$'::text))
  constraint oauth_codes_owner_fkey: FOREIGN KEY (owner) REFERENCES auth.users(id) ON DELETE CASCADE
  constraint oauth_codes_pkey: PRIMARY KEY (hash)
  constraint oauth_codes_session: FOREIGN KEY (session_id) REFERENCES auth.sessions(id) ON DELETE CASCADE
  constraint oauth_codes_way: CHECK ((way = ANY (ARRAY['google'::text, 'github'::text])))
  row level security: on
  grant postgres: DELETE, INSERT, REFERENCES, SELECT, TRIGGER, TRUNCATE, UPDATE
  grant service_role: DELETE, INSERT, REFERENCES, SELECT, TRIGGER, TRUNCATE, UPDATE
  rows: 1
