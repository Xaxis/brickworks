== constraints on oauth_tokens and oauth_grants
  oauth_codes oauth_codes_client_id_fkey: FOREIGN KEY (client_id) REFERENCES oauth_clients(client_id) ON DELETE CASCADE
  oauth_codes oauth_codes_code_challenge_check: CHECK ((code_challenge ~ '^[A-Za-z0-9_-]{43}$'::text))
  oauth_codes oauth_codes_hash_check: CHECK ((hash ~ '^[0-9a-f]{64}$'::text))
  oauth_codes oauth_codes_owner_fkey: FOREIGN KEY (owner) REFERENCES auth.users(id) ON DELETE CASCADE
  oauth_codes oauth_codes_pkey: PRIMARY KEY (hash)
  oauth_codes oauth_codes_way: CHECK ((way = ANY (ARRAY['google'::text, 'github'::text])))
  oauth_grants oauth_grants_channel_check: CHECK ((channel ~ '^[0-9a-f]{64}$'::text))
  oauth_grants oauth_grants_client_id_fkey: FOREIGN KEY (client_id) REFERENCES oauth_clients(client_id) ON DELETE CASCADE
  oauth_grants oauth_grants_owner_fkey: FOREIGN KEY (owner) REFERENCES auth.users(id) ON DELETE CASCADE
  oauth_grants oauth_grants_pkey: PRIMARY KEY (id)
  oauth_grants oauth_grants_way: CHECK ((way = ANY (ARRAY['google'::text, 'github'::text])))
  oauth_tokens oauth_tokens_grant_id_fkey: FOREIGN KEY (grant_id) REFERENCES oauth_grants(id) ON DELETE CASCADE
  oauth_tokens oauth_tokens_hash_check: CHECK ((hash ~ '^[0-9a-f]{64}$'::text))
  oauth_tokens oauth_tokens_kind_check: CHECK ((kind = ANY (ARRAY['access'::text, 'refresh'::text])))
  oauth_tokens oauth_tokens_pkey: PRIMARY KEY (hash)
